# 配置文件（包含密钥）
.env

# IDE
.idea/
*.iml
.vscode/

# 构建产物
target/
frontend/dist/

# 依赖目录（绝不入库）
node_modules/
frontend/node_modules/

# Vite 缓存
.vite/
frontend/node_modules/.vite/

# 运行时数据（H2 数据库，含飞书 appSecret 等敏感配置，绝不入库）
data/
*.mv.db
*.trace.db

# 临时验证脚手架
verify/

# OS
.DS_Store
Thumbs.db

# 日志
*.log

# agent 测试时产生的临时文件
*.tmp.json

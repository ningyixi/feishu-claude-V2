# ===== 飞书应用配置 =====
# 在飞书开放平台 (https://open.feishu.cn) 创建应用后获取
FEISHU_APP_ID=cli_xxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# ===== Claude API 配置 =====
# 从 https://console.anthropic.com 获取 API Key
CLAUDE_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 可选：模型选择（默认 claude-sonnet-4-20250514）
# 其他可选: claude-opus-4-20250514, claude-sonnet-4-20250514, claude-haiku-3-5
CLAUDE_MODEL=claude-sonnet-4-20250514

# 可选：API Base URL（如果使用代理或中转服务）
# 默认: https://api.anthropic.com
CLAUDE_BASE_URL=https://api.anthropic.com

# Container stack: generate .env.mysql with python3 scripts/database.py init.
# Native/JDBC tooling only (the application default profile is mysql):
# FEISHU_MYSQL_URL=jdbc:mysql://localhost:3307/feishu_claude?characterEncoding=UTF-8&connectionTimeZone=UTC
# FEISHU_MYSQL_USER=feishu
# FEISHU_MYSQL_PASSWORD=<local generated password>
# Legacy H2: --spring.profiles.active=h2 and FEISHU_DB_PATH=<path without .mv.db>

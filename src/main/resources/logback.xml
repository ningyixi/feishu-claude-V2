<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- 飞书 SDK 日志 -->
    <logger name="com.lark.oapi" level="INFO"/>

    <!-- 本项目日志 -->
    <logger name="com.lark.oapi.sample" level="DEBUG"/>

    <!-- OkHttp 日志（调试时可改为 DEBUG） -->
    <logger name="okhttp3" level="INFO"/>

    <root level="INFO">
        <appender-ref ref="STDOUT"/>
    </root>
</configuration>

<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <appender name="SSE" class="com.lark.oapi.sample.ws.config.SseLogAppender"/>

    <logger name="com.lark.oapi" level="INFO"/>
    <logger name="com.lark.oapi.sample" level="DEBUG"/>
    <logger name="okhttp3" level="INFO"/>

    <root level="INFO">
        <appender-ref ref="STDOUT"/>
        <appender-ref ref="SSE"/>
    </root>
</configuration>
